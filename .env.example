# 使用方式：cp .env.example .env，然后按 SIMPLERCP_LLM_PROVIDER 填写 DEEPSEEK_API_KEY 或 MINIMAX_API_KEY。
# .env 只由服务端读取，禁止提交真实密钥。

# SimpleRCPv2 服务端
PORT=4000
SIMPLERCP_HOST=127.0.0.1
SIMPLERCP_PUBLIC_URL=http://127.0.0.1:5173
SIMPLERCP_TERMINAL_ENABLED=true
# Guard 请求模式：full=角色与审批，human-only=只管控人员终端，native=Agent 平台原生权限（用户实验关闭条件），off=关闭 Guard
SIMPLERCP_GUARD_MODE=full
# Guard 请求审批：off=人工审批，suggest=模型建议，auto=模型自动审批
SIMPLERCP_GUARD_LLM_MODE=suggest
SIMPLERCP_GUARD_APPROVAL_TIMEOUT_MS=120000
# 单次模型判断的超时
SIMPLERCP_GUARD_LLM_TIMEOUT_MS=15000

# 可选路径均使用绝对路径，留空时使用默认目录
SIMPLERCP_DATA_DIR=
SIMPLERCP_WORKSPACES_DIR=
SIMPLERCP_IMPORT_ROOTS=

# Agent 与 Guard 模型判断共用的模型提供方：deepseek 或 minimax
SIMPLERCP_LLM_PROVIDER=deepseek

# OpenCode 与 DeepSeek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# 可选 Agent 运行设置
SIMPLERCP_OPENCODE_PORT=4096
SIMPLERCP_AGENT_RUN_TIMEOUT_MS=600000
SIMPLERCP_AGENT_MAX_CONCURRENT_RUNS=3
SIMPLERCP_AGENT_WAITING_MS=20000
SIMPLERCP_AGENT_STALLED_MS=60000

# 可选终端和 Agent 环境变量白名单，使用逗号分隔
SIMPLERCP_TERMINAL_HOME=
SIMPLERCP_TERMINAL_ENV_ALLOW=
SIMPLERCP_AGENT_ENV_ALLOW=

# 客户端默认使用以下地址。单独启动客户端并修改端口时，通过 shell 环境变量传入。
# VITE_SIMPLERCP_API_ORIGIN=http://127.0.0.1:4000
# VITE_SIMPLERCP_CLIENT_HOST=127.0.0.1
# VITE_SIMPLERCP_CLIENT_PORT=5173

# OpenCode 与 MiniMax（SIMPLERCP_LLM_PROVIDER=minimax 时使用）
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M3
