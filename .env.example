# 使用方式：cp .env.example .env，然后填写 DEEPSEEK_API_KEY 和 TYPESAFE_API_KEY。
# .env 只由服务端读取，禁止提交真实密钥。

# SimpleRCPv2 服务端
PORT=4000
SIMPLERCP_HOST=127.0.0.1
SIMPLERCP_PUBLIC_URL=http://127.0.0.1:5173
SIMPLERCP_TERMINAL_ENABLED=true
SIMPLERCP_FAKE_AGENT_RUNTIME=false

# 可选路径均使用绝对路径，留空时使用默认目录
SIMPLERCP_DATA_DIR=
SIMPLERCP_WORKSPACES_DIR=
SIMPLERCP_IMPORT_ROOTS=

# 语义冲突预防：off、observe、rules、full
# full 会启用模型研判与 Agent 闸门；没有模型密钥时请改为 rules。
CONFLICT_GUARD=full
CONFLICT_GUARD_STRATEGY=G3
CONFLICT_GUARD_THRESHOLD=0
CONFLICT_GUARD_PROVIDER_MODE=live
CONFLICT_GUARD_INVARIANTS=true
# 同声明修改行距离超过该数值且公开接口保持不变时给出警告。
CONFLICT_GUARD_BODY_ADJACENT_LINES=3
CONFLICT_GUARD_DEEP=deepseek
CONFLICT_GUARD_ARBITRATION=owner
CONFLICT_GUARD_INTENT_INJECTION=on
CONFLICT_GUARD_T2_STRATEGY=G1
CONFLICT_GUARD_T3_STRATEGY=G1
CONFLICT_GUARD_T2_REASONING=false
CONFLICT_GUARD_T3_REASONING=false

# OpenCode、DeepSeek 与 Jev
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash
TYPESAFE_API_KEY=
TYPESAFE_BASE_URL=https://api.typesafe.ai

# 可选 Agent 运行设置
SIMPLERCP_OPENCODE_PORT=4096
SIMPLERCP_AGENT_RUN_TIMEOUT_MS=600000
SIMPLERCP_AGENT_MAX_CONCURRENT_RUNS=3

# 可选终端和 Agent 环境变量白名单，使用逗号分隔
SIMPLERCP_TERMINAL_HOME=
SIMPLERCP_TERMINAL_ENV_ALLOW=
SIMPLERCP_AGENT_ENV_ALLOW=

# 可选 OpenAI-compatible 研判端点。启用时还要把 CONFLICT_GUARD_DEEP 改为 openai-compatible。
ADJUDICATION_COMPATIBLE_API_KEY=
ADJUDICATION_COMPATIBLE_BASE_URL=
ADJUDICATION_COMPATIBLE_MODEL=

# 客户端默认使用以下地址。单独启动客户端并修改端口时，通过 shell 环境变量传入。
# VITE_SIMPLERCP_API_ORIGIN=http://127.0.0.1:4000
# VITE_SIMPLERCP_CLIENT_HOST=127.0.0.1
# VITE_SIMPLERCP_CLIENT_PORT=5173
