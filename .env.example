# 使用方式：cp .env.example .env，然后填写当前 provider 的 API Key。
# .env 只由服务端读取，禁止提交真实密钥。

# SimpleRCPv2 服务端
PORT=4000
SIMPLERCP_HOST=127.0.0.1
SIMPLERCP_PUBLIC_URL=http://127.0.0.1:5173
SIMPLERCP_TERMINAL_ENABLED=true

# 可选路径均使用绝对路径，留空时使用默认目录
SIMPLERCP_DATA_DIR=
SIMPLERCP_WORKSPACES_DIR=
SIMPLERCP_IMPORT_ROOTS=

# 过程性知识功能：off、capture、inject、full
KNOWLEDGE=off
# 记录可回放的协作事件
KNOWLEDGE_RECORD_EVENTS=true

# OpenCode Agent 模型提供方
AGENT_LLM_PROVIDER=minimax
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-flash

# 服务端知识模块模型。存在 MINIMAX_API_KEY 时默认使用 MiniMax
KNOWLEDGE_LLM_PROVIDER=
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1
MINIMAX_MODEL=MiniMax-M2
AGENT_MINIMAX_MODEL=

# 可选 Agent 运行设置
SIMPLERCP_OPENCODE_PORT=4096
SIMPLERCP_AGENT_RUN_TIMEOUT_MS=600000
SIMPLERCP_AGENT_MAX_CONCURRENT_RUNS=3
SIMPLERCP_AGENT_WAITING_MS=20000
SIMPLERCP_AGENT_STALLED_MS=60000

# 可选终端和 Agent 环境变量白名单，使用逗号分隔
SIMPLERCP_TERMINAL_HOME=
SIMPLERCP_TERMINAL_ENV_ALLOW=
SIMPLERCP_AGENT_ENV_ALLOW=

# 客户端默认使用以下地址。单独启动客户端并修改端口时，通过 shell 环境变量传入。
# VITE_SIMPLERCP_API_ORIGIN=http://127.0.0.1:4000
# VITE_SIMPLERCP_CLIENT_HOST=127.0.0.1
# VITE_SIMPLERCP_CLIENT_PORT=5173
