{
  "name": "collaboration-server-workspaces",
  "private": true,
  "type": "module",
  "engineStrict": true,
  "engines": {
    "node": ">=20.10.0",
    "npm": ">=10.2.3"
  },
  "scripts": {
    "clean": "shx rm -rf packages/*/lib packages/*/out packages/*/bundle packages/*/*.tsbuildinfo",
    "build": "tsc -b tsconfig.build.json && npm run build --workspaces",
    "watch": "tsc -b tsconfig.build.json -w",
    "build:clean": "npm run clean && npm run build",
    "lint": "eslint",
    "lint:fix": "eslint --fix",
    "check:acceptance": "tsx packages/open-collaboration-agent/test/fixtures/check-acceptance-results-cli.ts",
    "check:acceptance:strict": "tsx packages/open-collaboration-agent/test/fixtures/check-acceptance-results-cli.ts --strict",
    "check:paper-evidence": "tsx packages/open-collaboration-agent/test/fixtures/check-paper-evidence-cli.ts",
    "check:paper-evidence:strict": "tsx packages/open-collaboration-agent/test/fixtures/check-paper-evidence-cli.ts --strict",
    "test:prototype": "vitest --run packages/open-collaboration-agent/test/paper-evidence-check.test.ts packages/open-collaboration-agent/test/acceptance-scripts.test.ts packages/open-collaboration-vscode/test/knowledge-command-manifest.test.ts packages/open-collaboration-agent/test/acceptance-results-check.test.ts packages/open-collaboration-agent/test/headless-functional-validation.test.ts packages/open-collaboration-agent/test/knowledge-index-demo-cards.test.ts packages/open-collaboration-knowledge/test/anchor-review.test.ts packages/open-collaboration-knowledge/test/demo-cards.test.ts packages/open-collaboration-knowledge/test/knowledge-views.test.ts packages/open-collaboration-knowledge/test/anchor-robustness-pilot.test.ts",
    "test:anchor-benchmark": "vitest --run packages/open-collaboration-knowledge/test/anchor-benchmark.test.ts",
    "test:ai-coding-benchmark": "vitest --run packages/open-collaboration-agent/test/ai-coding-benchmark.test.ts packages/open-collaboration-agent/test/ai-coding-benchmark-analysis.test.ts",
    "test:retrieval-stress": "vitest --run packages/open-collaboration-agent/test/retrieval-stress-benchmark.test.ts",
    "test:capture-quality": "vitest --run packages/open-collaboration-agent/test/capture-quality-benchmark.test.ts",
    "test:knowledge-scale": "vitest --run packages/open-collaboration-agent/test/knowledge-scale-benchmark.test.ts",
    "test:knowledge-cache": "vitest --run packages/open-collaboration-agent/test/knowledge-cache-benchmark.test.ts",
    "experiment:anchor": "tsx packages/open-collaboration-knowledge/test/fixtures/run-anchor-benchmark-cli.ts",
    "experiment:ai-coding-pilot": "node --env-file=.env --import tsx packages/open-collaboration-agent/test/fixtures/run-ai-coding-benchmark-cli.ts",
    "experiment:ai-coding-rescore": "tsx packages/open-collaboration-agent/test/fixtures/rescore-ai-coding-benchmark-cli.ts",
    "experiment:ai-coding-analyze": "tsx packages/open-collaboration-agent/test/fixtures/analyze-ai-coding-benchmark-cli.ts",
    "experiment:ai-coding-repeat-audit": "tsx packages/open-collaboration-agent/test/fixtures/audit-ai-coding-repeat-cli.ts",
    "experiment:retrieval-stress": "tsx packages/open-collaboration-agent/test/fixtures/run-retrieval-stress-benchmark-cli.ts",
    "experiment:capture-quality": "node --env-file=.env --import tsx packages/open-collaboration-agent/test/fixtures/run-capture-quality-benchmark-cli.ts",
    "experiment:capture-quality-report": "tsx packages/open-collaboration-agent/test/fixtures/render-capture-quality-report-cli.ts",
    "experiment:knowledge-scale": "tsx packages/open-collaboration-agent/test/fixtures/run-knowledge-scale-benchmark-cli.ts",
    "experiment:knowledge-cache": "tsx packages/open-collaboration-agent/test/fixtures/run-knowledge-cache-benchmark-cli.ts",
    "experiment:ai-coding-extended": "tsx packages/open-collaboration-agent/test/fixtures/analyze-ai-coding-extended-cli.ts",
    "check:prototype": "npm run build && npm run test:prototype && npm run check:acceptance && npm run check:paper-evidence",
    "check:prototype:strict": "npm run build && npm run test:prototype && npm run check:acceptance:strict && npm run check:paper-evidence:strict",
    "start": "npm run start --workspace=open-collaboration-server",
    "test": "vitest",
    "test-ui": "vitest --ui",
    "coverage": "vitest run --coverage",
    "reset:repo": "git clean -f -X -d",
    "dev": "vite",
    "dev:debug": "vite --debug --force"
  },
  "devDependencies": {
    "@eslint/eslintrc": "~3.3.1",
    "@eslint/js": "~9.24.0",
    "@stylistic/eslint-plugin": "~4.2.0",
    "@types/lodash": "~4.17.16",
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "~8.29.1",
    "@typescript-eslint/parser": "~8.29.1",
    "@vitest/coverage-v8": "~3.1.1",
    "@vitest/ui": "~3.1.1",
    "concurrently": "~9.1.2",
    "esbuild": "~0.25.2",
    "editorconfig": "~2.0.1",
    "eslint": "~9.24.0",
    "eslint-plugin-header": "~3.1.1",
    "eslint-plugin-import": "~2.31.0",
    "eslint-plugin-unused-imports": "~4.1.4",
    "monaco-editor": "0.44.0",
    "shx": "~0.4.0",
    "tsx": "~4.19.3",
    "typescript": "~5.8.3",
    "vite": "~6.2.6",
    "vitest": "~3.1.1",
    "postject": "~1.0.0-alpha.6"
  },
  "volta": {
    "node": "22.14.0",
    "npm": "10.9.2"
  },
  "workspaces": [
    "packages/*"
  ]
}
