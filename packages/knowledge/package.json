{
  "name": "@simplercp/knowledge",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./dist/src/index.d.ts",
  "exports": {
    ".": { "types": "./dist/src/index.d.ts", "default": "./dist/src/index.js" },
    "./schema": { "types": "./dist/src/schema/card.d.ts", "default": "./dist/src/schema/card.js" },
    "./capture/triggerPolicy": { "types": "./dist/src/capture/triggerPolicy.d.ts", "default": "./dist/src/capture/triggerPolicy.js" },
    "./capture/engine": { "types": "./dist/src/capture/engine.d.ts", "default": "./dist/src/capture/engine.js" },
    "./capture/events": { "types": "./dist/src/capture/events.d.ts", "default": "./dist/src/capture/events.js" },
    "./capture/authorship": { "types": "./dist/src/capture/authorship.d.ts", "default": "./dist/src/capture/authorship.js" },
    "./anchor/resolver": { "types": "./dist/src/anchor/resolver.d.ts", "default": "./dist/src/anchor/resolver.js" },
    "./anchor/review": { "types": "./dist/src/anchor/review.d.ts", "default": "./dist/src/anchor/review.js" },
    "./views/guide": { "types": "./dist/src/views/guide.d.ts", "default": "./dist/src/views/guide.js" },
    "./views/timeline": { "types": "./dist/src/views/timeline.d.ts", "default": "./dist/src/views/timeline.js" },
    "./extract": { "types": "./dist/src/extract/extract.d.ts", "default": "./dist/src/extract/extract.js" },
    "./retrieval/index": { "types": "./dist/src/retrieval/index.d.ts", "default": "./dist/src/retrieval/index.js" },
    "./retrieval/inject": { "types": "./dist/src/retrieval/inject.d.ts", "default": "./dist/src/retrieval/inject.js" },
    "./llm/client": { "types": "./dist/src/llm/client.d.ts", "default": "./dist/src/llm/client.js" },
    "./llm/openaiCompatible": { "types": "./dist/src/llm/openaiCompatible.d.ts", "default": "./dist/src/llm/openaiCompatible.js" },
    "./demo": { "types": "./dist/src/demo/demoCards.d.ts", "default": "./dist/src/demo/demoCards.js" },
    "./util/hash": { "types": "./dist/src/util/hash.d.ts", "default": "./dist/src/util/hash.js" }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "replay": "tsx src/capture/replayCli.ts",
    "bench:anchor": "tsx test/fixtures/run-anchor-benchmark-cli.ts",
    "bench:retrieval-stress": "tsx bench/run-deterministic.ts --only retrieval-stress",
    "bench:scale": "tsx bench/run-deterministic.ts --only knowledge-scale",
    "bench:cache": "tsx bench/run-deterministic.ts --only knowledge-cache",
    "bench:capture-quality": "tsx bench/run-deterministic.ts --only capture-quality",
    "bench:status-gate": "tsx bench/run-deterministic.ts --only status-gate",
    "bench:deterministic": "tsx bench/run-deterministic.ts",
    "bench:capture-quality:llm": "node --env-file=../../.env --import tsx bench/run-capture-quality-llm.ts"
  },
  "dependencies": { "typescript": "^5.4.0" },
  "devDependencies": { "@types/node": "^20.11.0", "tsx": "^4.7.0", "vitest": "^1.4.0" }
}
