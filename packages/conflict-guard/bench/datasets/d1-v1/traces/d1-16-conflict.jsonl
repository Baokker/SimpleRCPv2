{"schema":3,"seq":4,"at":0,"type":"doc_open","file":"src/logic.ts","text":"import type { CalendarEntry } from \"./types.ts\";\nexport function overlaps(left: CalendarEntry, right: CalendarEntry): boolean { return left.start < right.end && right.start < left.end; }\nexport function duration(entry: CalendarEntry): number { if (entry.end < entry.start) throw new RangeError(\"time range\"); return entry.end - entry.start; }\n","textHash":"fb1396c61398ffe1b3fe809bf22263bad49a658563999aa31a2bb459c8ddaa41"}
{"schema":3,"seq":5,"at":0,"type":"doc_open","file":"src/producer.ts","text":"export function applyDiscount(price: number, rate: number = 0.1) { if (price < 0) return 0; return price * (1 - rate); }\n","textHash":"8d0c535e7339906f2f74982654cfbd95527cc8921609bfc7c0a78e19e70c9cad"}
{"schema":3,"seq":6,"at":0,"type":"doc_open","file":"src/selectors.ts","text":"import type { CalendarEntry } from \"./types.ts\";\nimport { overlaps } from \"./logic.ts\";\nexport function conflicts(entries: CalendarEntry[], proposal: CalendarEntry): CalendarEntry[] { return entries.filter((entry) => overlaps(entry, proposal)); }\n","textHash":"2f7b5cde447e4699f2a820a6e1cd09fcbc58bd6c00d5d1a36a22df87f82a8a4b"}
