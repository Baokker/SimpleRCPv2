{"schema":3,"seq":4,"at":0,"type":"doc_open","file":"src/logic.ts","text":"import type { InventoryItem } from \"./types.ts\";\nexport function available(item: InventoryItem, requested: number): boolean { return requested > 0 && item.count >= requested; }\nexport function reserve(item: InventoryItem, requested: number): InventoryItem { if (!available(item, requested)) throw new RangeError(\"quantity\"); return { ...item, count: item.count - requested }; }\n","textHash":"ace51fefca9711d836da8895db7d016a8d7e5f5b2dc74eeb59cb4a8887100671"}
{"schema":3,"seq":5,"at":0,"type":"doc_open","file":"src/producer.ts","text":"let configuredRate = 0.1;\nexport function reset() { configuredRate = 0.1; }\nexport function setRate(value: number) { configuredRate = value; }\nexport function initialize() {}\nexport function applyDiscount(price: number, rate: number = 0.1) { return price * (1 - configuredRate); }\n","textHash":"9dc04f91e8355d810f522b515fa150611010361542c2ad77a90f307cdf78eb30"}
{"schema":3,"seq":6,"at":0,"type":"doc_open","file":"src/selectors.ts","text":"import type { InventoryItem } from \"./types.ts\";\nimport { available } from \"./logic.ts\";\nexport function inStock(items: InventoryItem[]): string[] { return items.filter((item) => available(item, 1)).map((item) => item.sku); }\n","textHash":"335f1c1f34f0696b4b12c6688a76a9069f884c0254c138711cc903dee910c628"}
