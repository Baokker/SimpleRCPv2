{"schema":3,"seq":4,"at":0,"type":"doc_open","file":"src/logic.ts","text":"import type { Permission } from \"./types.ts\";\nexport function canAccess(grants: Permission[], subject: string, action: string): boolean { return grants.some((grant) => grant.subject === subject && grant.action === action); }\nexport function requireAccess(grants: Permission[], subject: string, action: string): void { if (!canAccess(grants, subject, action)) throw new Error(\"access denied\"); }\n","textHash":"893726828a568c5adae7f07bfc487a5811bec0c374d909377c9d48344842d0a3"}
{"schema":3,"seq":5,"at":0,"type":"doc_open","file":"src/producer.ts","text":"export function applyDiscount(price: number, rate: number = 0.1) { if (price < 0) return 0; return price * (1 - rate); }\n","textHash":"8d0c535e7339906f2f74982654cfbd95527cc8921609bfc7c0a78e19e70c9cad"}
{"schema":3,"seq":6,"at":0,"type":"doc_open","file":"src/selectors.ts","text":"import type { Permission } from \"./types.ts\";\nimport { canAccess } from \"./logic.ts\";\nexport function visibleActions(grants: Permission[], subject: string): string[] { return [\"read\", \"write\", \"delete\"].filter((action) => canAccess(grants, subject, action)); }\n","textHash":"2979a508879d474b1cec41063c14883b20454cc8b831dd19b13c346b17dcfe63"}
