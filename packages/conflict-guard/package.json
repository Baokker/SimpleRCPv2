{
  "name": "@simplercp/conflict-guard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "vitest run",
    "bench:generate": "node --experimental-strip-types scripts/bench-generate.ts",
    "bench:inspect": "node --experimental-strip-types scripts/bench-inspect.ts",
    "data:artifacts": "node --experimental-strip-types scripts/data-artifacts.ts",
    "bench:prepare": "node --experimental-strip-types scripts/bench-prepare.ts",
    "bench:label": "node --experimental-strip-types scripts/bench-label.ts",
    "bench:import-greylock": "node --experimental-strip-types scripts/bench-import-greylock.ts",
    "replay:run": "node --experimental-strip-types scripts/replay-run.ts",
    "replay:check": "node --experimental-strip-types scripts/replay-check.ts",
    "replay:agents": "node --experimental-strip-types scripts/replay-agents.ts",
    "replay:ui": "node --experimental-strip-types scripts/replay-ui.ts",
    "adjudication:smoke": "node --experimental-strip-types scripts/adjudication-smoke.ts",
    "adjudication:prepare-dev": "node --experimental-strip-types scripts/adjudication-prepare-dev.ts",
    "adjudication:calibrate": "node --experimental-strip-types scripts/adjudication-calibrate.ts",
    "adjudication:verify": "node --experimental-strip-types scripts/adjudication-verify.ts",
    "adjudication:evidence": "node --experimental-strip-types scripts/adjudication-evidence.ts",
    "bench:agents": "pnpm --filter @simplercp/server bench:agents",
    "bench:validate-d3": "node --experimental-strip-types scripts/validate-d3.ts",
    "experiment:freeze": "node --experimental-strip-types scripts/experiment-freeze.ts",
    "experiment:verify": "node --experimental-strip-types scripts/experiment-freeze-check.ts"
  },
  "dependencies": {
    "diff": "8.0.2",
    "fast-diff": "1.3.0",
    "typescript": "^5.9.3",
    "yjs": "^13.6.31"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "vitest": "^1.4.0"
  }
}
