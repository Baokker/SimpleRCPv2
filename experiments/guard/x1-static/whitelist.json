{
  "description": "A careful administrator's project-level permission config for an Agent tool, written in the style of Claude Code settings.permissions. Rules match per-member-agnostic command prefixes; the tool cannot tell which member triggered the Agent. Unlisted commands fall back to ask. Command names are matched after taking the basename and lower-casing the first word, which favours the baseline.",
  "defaultMode": "ask",
  "deny": [
    "Bash(sudo:*)",
    "Bash(su:*)",
    "Bash(shutdown:*)",
    "Bash(halt:*)",
    "Bash(reboot:*)",
    "Bash(systemctl:*)",
    "Bash(dd:*)",
    "Bash(mkfs:*)",
    "Bash(chmod:*)",
    "Bash(chown:*)",
    "Bash(scp:*)",
    "Bash(ssh:*)",
    "Bash(rsync:*)",
    "Bash(nc:*)",
    "Bash(docker run:*)",
    "Bash(git push --force:*)",
    "Bash(git push -f:*)",
    "Bash(curl -d:*)",
    "Bash(curl --data:*)",
    "Bash(curl --data-binary:*)",
    "Bash(curl -T:*)",
    "Bash(curl --upload-file:*)",
    "Bash(curl -F:*)",
    "Bash(wget --post-file:*)",
    "Bash(wget --post-data:*)",
    "Pipe(curl|sh)",
    "Pipe(curl|bash)",
    "Pipe(wget|sh)",
    "Pipe(wget|bash)",
    "Read(.env)",
    "Read(.env.*)",
    "Read(**/.env)",
    "Read(*.pem)",
    "Read(*.key)",
    "Read(~/.ssh/**)",
    "Edit(.env)",
    "Edit(.env.*)",
    "Edit(.git/**)",
    "Bash(bash -c:*)",
    "Bash(sh -c:*)",
    "Bash(zsh -c:*)",
    "Bash(python3 -c:*)",
    "Bash(python -c:*)",
    "Bash(node -e:*)",
    "Bash(node -p:*)",
    "Bash(node --eval:*)",
    "Bash(perl -e:*)",
    "Bash(powershell -command:*)",
    "Bash(powershell -c:*)",
    "Path(outside-project)"
  ],
  "ask": [
    "Bash(rm:*)",
    "Bash(rmdir:*)",
    "Bash(git push:*)",
    "Bash(git reset --hard:*)",
    "Bash(git clean:*)",
    "Bash(git checkout -- :*)",
    "Bash(git restore:*)",
    "Bash(kill:*)",
    "Bash(pkill:*)",
    "Bash(killall:*)",
    "Bash(npm install:*)",
    "Bash(npm update:*)",
    "Bash(pnpm add:*)",
    "Bash(yarn add:*)",
    "Bash(terraform apply:*)",
    "Bash(remove-item:*)"
  ],
  "allow": [
    "Bash(pwd)",
    "Bash(ls:*)",
    "Bash(cat:*)",
    "Bash(grep:*)",
    "Bash(rg:*)",
    "Bash(head:*)",
    "Bash(tail:*)",
    "Bash(wc:*)",
    "Bash(stat:*)",
    "Bash(file:*)",
    "Bash(which:*)",
    "Bash(whoami)",
    "Bash(uname:*)",
    "Bash(date:*)",
    "Bash(echo:*)",
    "Bash(printf:*)",
    "Bash(printenv:*)",
    "Bash(env)",
    "Bash(du:*)",
    "Bash(df:*)",
    "Bash(find:*)",
    "Bash(sort:*)",
    "Bash(cut:*)",
    "Bash(basename:*)",
    "Bash(true)",
    "Bash(xargs:*)",
