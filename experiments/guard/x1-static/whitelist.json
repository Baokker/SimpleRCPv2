    "Bash(node --version)",
    "Bash(npm test:*)",
    "Bash(npm run test:*)",
    "Bash(npm run build:*)",
    "Bash(npm run lint:*)",
    "Bash(pnpm test:*)",
    "Bash(pnpm build:*)",
    "Bash(yarn test:*)",
    "Bash(yarn build:*)",
    "Bash(npx vitest:*)",
